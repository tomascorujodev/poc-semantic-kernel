<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>2c91a3a6-866a-451b-8786-06aee448ead0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" Version="1.80.1" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Orchestration" Version="1.80.1-preview" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Runtime.InProcess" Version="1.80.1-preview" />
  </ItemGroup>

  <ItemGroup>
    <!-- Step 3: documents for RAG, copied next to the .exe -->
    <None Include="Data\Docs\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
